// Test of CBZ and B instruction.
// Requires:
// ADDI, ADDS, SUB, CBZ, B.LT, B, LDUR, STUR
// Expected results:
// X0 = 0
// X1 = 8
// X2 = 4 (on pipelined CPU), or 0 (single-cycle CPU).
// X3 = 5
// X4 = 7
// X5 = 2
// X6 = -2 // mycase: 0
// X7 = -2  // mycase: 3
// X8 = 0
// X9 = 1
// X10 = -4 // mycase: -2
// X14 = 5
// X15 = 8 
// X16 = 9 // mycase: 1
// X17 = 1
// X18 = 99
// Mem[0] = 8 
// Mem[8] = 5

//ADDI: I-type, Reg[Rd] = Reg[Rn] + {'0, Imm12}
//OP         Imm12        Rn    Rd
//3322222222 221111111111 00000 00000
//1098765432 109876543210 98765 43210
//1001000100 Unsigned     0..31 0..31

//B: B-type, PC = PC + SignExtend({Imm26, 2'b00})
//OP     Imm26
//332222 22222211111111110000000000
//109876 54321098765432109876543210
//000101 2's Comp Imm26

//CBZ: CB-type, if (R[Rt] == 0) PC = PC + SignExtend({Imm19, 2'b00})
//OP       Imm19               Rt
//33222222 2222111111111100000 00000
//10987654 3210987654321098765 43210
//10110100 2's Comp Imm19      0..31

//SUBS: R-type, Reg[Rd] = Reg[Rn] - Reg[Rm]
//OP          Rm    Shamt  Rn    Rd
//33222222222 21111 111111 00000 00000
//10987654321 09876 543210 98765 43210
//11101011000 0..31 000000 0..31 0..31

//ADDS: R-type, Reg[Rd] = Reg[Rn] + Reg[Rm]
//OP          Rm    Shamt  Rn    Rd
//33222222222 21111 111111 00000 00000
//10987654321 09876 543210 98765 43210
//10101011000 0..31 000000 0..31 0..31

//B.LT: CB-type, if (flags meet condition) PC = PC + SignExtend({Imm19, 2'b00})
//OP       Imm19               Cond
//33222222 2222111111111100000 00000
//10987654 3210987654321098765 43210
//01010100 2's Comp Imm19      01011

//LDUR: D-type, Reg[Rt] = Mem[Reg[Rn] + SignExtend(Imm9)]
//OP          Imm9      00 Rn    Rt
//33222222222 211111111 11 00000 00000
//10987654321 098765432 10 98765 43210
//11111000010 2's Comp  00 0..31 0..31

//STUR: D-type, Mem[Reg[Rn] + SignExtend(Imm9)] = Reg[Rt]
//OP          Imm9      00 Rn    Rt
//33222222222 211111111 11 00000 00000
//10987654321 098765432 10 98765 43210
//11111000000 2's Comp  00 0..31 0..31

               // MAIN:
1001000100_000000000000_11111_00000    // ADDI X0, X31, #0        // #0 X0 = 0
1001000100_000000000000_11111_00001    // ADDI X1, X31, #0        // #4 X1 = 0
1001000100_000000000000_11111_00010    // ADDI X2, X31, #0        // #8 X2 = 0, counter of branch delay slots.
               // // Simple forwarding
1001000100_000000000101_11111_00011    // ADDI X3, X31, #5        // #12 X3 = 5
1001000100_000000000010_00011_00100    // ADDI X4, X3, #2         // #16 X4 = 7
11101011000_00011_000000_00100_00101   // SUBS X5, X4, X3         // #20 X5 = 2
11101011000_00100_000000_00011_00110   // SUBS X6, X3, X4         // #24 X6 = -2
11101011000_00100_000000_00011_00111   // SUBS X7, X3, X4         // #28 X7 = -2  
               // // Forwarding and X31
1001000100_111111111111_11111_11111    // ADDI X31, X31, #-1      // #32 Writing -1 to X31, but it should stay as 0
11101011000_11111_000000_00001_01000   // SUBS X8, X1, X31        // #36 X8 = 0
11101011000_01000_000000_11111_01000   // SUBS X8, X31, X8        // #40 X8 = 0
11101011000_11111_000000_01000_01000   // SUBS X8, X8, X31        // #44 X8 = 0
11101011000_11111_000000_01000_01000   // SUBS X8, X8, X31        // #48 X8 = 0
               // // Forwarding in the face of multiple writes
1001000100_000000000010_11111_01001    // ADDI X9, X31, #2        // #52 X9 = 2
1001000100_000000000001_11111_01001    // ADDI X9, X31, #1        // #56 X9 = 1
11101011000_01001_000000_11111_01010   // SUBS X10, X31, X9       // #60 X10 = -1
11101011000_01001_000000_01010_01010   // SUBS X10, X10, X9       // #64 X10 = -2
11101011000_01001_000000_01010_01010   // SUBS X10, X10, X9       // #68 X10 = -3
11101011000_01001_000000_01010_01010   // SUBS X10, X10, X9       // #72 X10 = -4
               // // Forwarding involving an instruction that doesn't write the register file
11111000000_000000001_00_00100_00011   // STUR X3, [X4, #1]       // #76 Mem[8] = 5
1001000100_000000000000_00011_01110    // ADDI X14, X3, #0        // #80 X14 = 5
               // // Forwarding and load/store instructions
1001000100_000000001000_11111_00001    // ADDI X1, X31, 8         // #84 X1 = 8
11111000000_000000000_00_11111_00001   // STUR X1, [X31, #0]      // #88 Mem[0] = 8
11111000010_000000000_00_11111_01111   // LDUR X15, [X31, #0]     // #92 X15 = Mem[0] = 8
1001000100_000000000000_11111_11111    // ADDI X31, X31, 0        // #96 Noop
1001000100_000000000001_01111_10000    // ADDI X16, X15, 1        // #100 X16 = 9
               // // Flags and the pipelined CPU (set flag and quickly or slowly branch).
10101011000_11111_000000_11111_11111   // ADDS X31, X31, X31      // #104 Noop that sets all flags to 0.
11101011000_00011_000000_11111_11111   // SUBS X31, X31, X3       // #108 Yes, 0 < 5.  Set flags
01010100_0000000000000000100_01011     // B.LT TAKEN1             // #112 Take the branch (+4).
1001000100_000000000001_00010_00010    // ADDI X2, X2, #1         // #116 X2 = 1 (increment delay slot counter)
               // ERROR1:
000101_00000000000000000000000000      // B ERROR1                // #120 Should never get here (0).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #124 Noop
               // TAKEN1:
10101011000_11111_000000_11111_11111   // ADDS X31, X31, X31      // #128 Noop that sets all flags to 0.
11101011000_00011_000000_11111_11111   // SUBS X31, X31, X3       // #132 Yes, 0 < 5.  Set flags
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #136 Noop - same as above but 1 cycle later.
01010100_0000000000000000100_01011     // B.LT TAKEN2             // #140 Take the branch (+4).
1001000100_000000000001_00010_00010    // ADDI X2, X2, #1         // #144 X2 = 2 (increment delay slot counter)
               // ERROR2:
000101_00000000000000000000000000      // B ERROR2                // #148 Should never get here (0).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #152 Noop
               // TAKEN2:
10101011000_11111_000000_11111_11111   // ADDS X31, X31, X31      // #156 Noop that sets all flags to 0.
11101011000_00011_000000_11111_11111   // SUBS X31, X31, X3       // #160 Yes, 0 < 5.  Set flags
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #164 Noop - same as above but much longer.
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #168 Noop
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #172 Noop
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #176 Noop
01010100_0000000000000000100_01011     // B.LT TAKEN3             // #180 Take the branch (+4).
1001000100_000000000001_00010_00010    // ADDI X2, X2, #1         // #184 X2 = 3 (increment delay slot counter)
               // ERROR3:
000101_00000000000000000000000000      // B ERROR3                // #188 Should never get here (0).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #192 Noop
               // TAKEN3:
1001000100_000000000001_11111_10001    // ADDI X17, X31, #1       // #196 X17 = 1
               // // Forwarding to conditional branch
1001000100_000000000010_11111_00000    // ADDI X0, X31, #2        // #200 X0 = 2
10110100_0000000000000000101_00000     // CBZ X0, ERROR4          // #204 Should not be taken (+5).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #208 Noop.
1001000100_000000000000_11111_00000    // ADDI X0, X31, #0        // #212 X0 = 0
10110100_0000000000000000100_00000     // CBZ X0, SUCCESS         // #216 Should be taken (+4).
1001000100_000000000001_00010_00010    // ADDI X2, X2, #1         // #220 X2 = 4 (increment delay slot counter)
               // ERROR4:
000101_00000000000000000000000000      // B ERROR4                // #224 Loop forever (0).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #228 Noop.
               // SUCCESS:
1001000100_000001100011_11111_10010    // ADDI X18, X31, #99      // #232 Show that we did finish.
               // HALT:
000101_00000000000000000000000000      // B HALT                  // #236 Done (0).
1001000100_000000000000_11111_11111    // ADDI X31, X31, #0       // #240 Noop.
